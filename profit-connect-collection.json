{
  "info": {
    "name": "Profit Connect API",
    "description": "مجموعة شاملة لجميع واجهات منصة Profit Connect — قابلة للاستيراد في Postman أو Bruno",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "🔐 Auth",
      "description": "تسجيل ودخول المستخدمين",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "تسجيل مستخدم جديد",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "email", "value": "user@example.com", "type": "text" },
                { "key": "password", "value": "12345678", "type": "text" },
                { "key": "role", "value": "JobSeeker", "type": "text" },
                { "key": "firstName", "value": "أحمد", "type": "text" },
                { "key": "lastName", "value": "محمد", "type": "text" },
                { "key": "avatar", "value": "", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{base_url}}/api/auth/signup", "host": ["{{base_url}}"], "path": ["api", "auth", "signup"] }
          }
        },
        {
          "name": "تسجيل الدخول",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"12345678\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.token) {",
                  "  pm.environment.set('token', jsonData.token);",
                  "  pm.environment.set('userId', jsonData.data?._id || jsonData.user?._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "المستخدم الحالي",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
